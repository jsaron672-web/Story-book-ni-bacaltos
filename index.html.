.genre{margin:0 0 .4rem;font-size:.85rem;color:var(--accent);font-weight:600}
.featured{margin-top:2rem}
.empty{text-align:center;color:var(--muted)}
.story{max-width:720px;margin:0 auto}
.story-head{display:flex;flex-wrap:wrap;gap:1.5rem;align-items:flex-end;margin-bottom:1.5rem}
