a{color:var(--accent)}
.sr{position:absolute;left:-9999px}
.site-header{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;justify-content:space-between;padding:.8rem 5%;background:var(--surface);border-bottom:2px solid var(--line);position:sticky;top:0;z-index:10}
