.btn{display:inline-block;padding:.55rem 1.1rem;border:2px solid var(--accent);border-radius:8px;background:var(--accent);color:var(--accent-ink);font:600 .95rem "Literata",serif;text-decoration:none;cursor:pointer;transition:transform .15s,box-shadow .15s}
