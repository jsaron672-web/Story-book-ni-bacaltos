      document.querySelectorAll('.cover img[data-img]').forEach(coverImg);
      document.querySelectorAll('[data-ck]').forEach(b=>resolve('covers',b.dataset.ck).then(u=>{if(u)b.dataset.cover=u;}));
      const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){io.unobserve(e.target);storyImg(e.target.querySelector('img'));}}),{rootMargin:'800px'});
